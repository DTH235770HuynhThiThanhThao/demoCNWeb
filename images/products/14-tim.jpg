entColor" stroke-width="0" viewBox="0 0 512 512" class="size-6" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><circle cx="176" cy="416" r="16" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"></circle><circle cx="400" cy="416" r="16" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"></circle><path fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="32" d="M48 80h64l48 272h256"></path><path fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="32" d="M160 288h249.44a8 8 0 0 0 7.85-6.43l28.8-144a8 8 0 0 0-7.85-9.57H128"></path></svg></button></div><div id="bottom-header" class="w-full empty:hidden"></div></header><div class="h-24"></div><main class="mx-auto max-w-screen-xl"><!--$--><!--/$--><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","@id":"https://cellphones.com.vn/iphone-14.html#total_comment","url":"https://cellphones.com.vn/iphone-14.html","mainEntity":[{"@type":"Question","name":"Pin iPhone 14 có dung lượng bao nhiêu, dùng được trong bao lâu? Có hỗ trợ sạc nhanh không?","acceptedAnswer":{"@type":"Answer","text":"iPhone 14 có dung lượng 3.279 mAh với thời gian phát video tối đa 20 giờ, đồng thời tích hợp công suất sạc nhanh 20W trở lên hỗ trợ rút ngắn thời gian sạc pin xuống còn 1 tiếng rưỡi."}},{"@type":"Question","name":"iPhone 14 có mấy SIM? Bản eSim có dùng được ở Việt Nam?","acceptedAnswer":{"@type":"Answer","text":"iPhone 14 có 2 loại SIM cho người dùng lựa chọn bao gồm: SIM kép (1 SIM vật lý và 1 eSIM) và eSIM. Tuy nhiên, chỉ có mẫu máy iPhone 14 tại Mỹ sẽ bị loại bỏ khe cắm SIM vật lý và chỉ sử dụng eSIM. Do đó iPhone 14 chính hãng tại Việt Nam vẫn còn khay sim vật lý và hỗ trợ eSIM."}},{"@type":"Question","name":"Camera của iPhone 14 có cải tiến nổi bật nào so với iPhone 13?","acceptedAnswer":{"@type":"Answer","text":"Cả 2 model đều sở hữu 2 cảm biến 12MP, bao gồm 1 cảm biến góc rộng tiêu chuẩn và 1 cảm biến góc siêu rộng. Tuy nhiên, điểm nâng cấp tạo nên sự khác biệt ở camera của iPhone 14 là cảm biến camera chính có khẩu độ f/1.5 tăng khả năng chụp thiếu sáng thêm 49% so với iPhone 1, do đó đem lại khả năng chụp thiếu sáng tốt hơn. Ngoài ra, camera góc rộng cũng được tối ưu để phơi sáng nhanh và bắt nét hiệu quả hơn."}},{"@type":"Question","name":"iPhone 14 có mấy màu? Màu đặc trưng của iPhone 14 2023 là màu nào?","acceptedAnswer":{"@type":"Answer","text":"iPhone 14 bao gồm 5 màu sắc trẻ trung và năng động phù hợp với nhiều lứa tuổi và đối tượng, cụ thể là Blue (xanh), Purple (tím), Midnight (đen), Starlight (trắng), Product (đỏ). Trong đó, hai màu hoàn toàn mới so với iPhone 13 là màu xanh và tím.&nbsp;"}}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"Product","name":"iPhone 14 128GB  | Chính hãng VN/A","image":"https://cdn2.cellphones.com.vn/200x/media/catalog/product/i/p/iphone-14_2_1.jpg","description":"Điện thoại iPhone 14 thường 128GB chính hãng VN/A, giá tốt, còn hàng mới, đủ màu - Mua ip 14 128gb trả góp 0%, 12 tháng CellphoneS ngay","offers":{"@type":"Offer","url":"https://cellphones.com.vn/iphone-14.html","priceCurrency":"VND","price":"16990000","itemCondition":"https://schema.org/NewCondition","availability":"https://schema.org/InStock","seller":{"@type":"Organization","name":"CELLPHONES"}},"additionalProperty":[{"@type":"PropertyValue","name":"Hệ điều hành khi ra mắt","value":"iOS 16"},{"@type":"PropertyValue","name":"Chipset","value":"Apple A15 Bionic 6 nhân"},{"@type":"PropertyValue","name":"Dung lượng RAM","value":"6 GB"},{"@type":"PropertyValue","name":"Bộ nhớ trong","value":"128 GB"},{"@type":"PropertyValue","name":"Loại CPU","value":" 3.22 GHz"},{"@type":"PropertyValue","name":"GPU","value":" Apple GPU 5 nhân"},{"@type":"PropertyValue","name":"Kích thước màn hình","value":"6.1 inches"},{"@type":"PropertyValue","name":"Công nghệ màn hình","value":"OLED"},{"@type":"PropertyValue","name":"Độ phân giải màn hình"