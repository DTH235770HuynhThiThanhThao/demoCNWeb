12715_7369)" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.595 18.635A9 9 0 0 1 5.625 7.5 9 9 0 0 0 12 5.25a9 9 0 0 0 6.375 2.25 9 9 0 0 1-.067 5.295M14.25 17.25l1.5 1.5 3-3"></path></g><defs><lineargradient id="paint0_linear_12715_7369" x1="13.462" x2="-37.95" y1="-49.875" y2="-8.237" gradientUnits="userSpaceOnUse"><stop stop-color="#ED8A95"></stop><stop offset="0.816" stop-color="#C40016"></stop></lineargradient><lineargradient id="paint1_linear_12715_7369" x1="12.005" x2="12.005" y1="5.25" y2="18.75" gradientUnits="userSpaceOnUse"><stop stop-color="#FFF5F0"></stop><stop offset="0.67" stop-color="#F4C8D0"></stop></lineargradient><clippath id="clip0_12715_7369"><path fill="#fff" d="M3 3h18v18H3z"></path></clippath></defs></svg><div><div class="inline">1 ĐỔI 1 trong 30 ngày nếu có lỗi phần cứng nhà sản xuất. Bảo hành 12 tháng tại trung tâm bảo hành chính hãng Apple: CareS.vn</div><a href="https://cellphones.com.vn/chinh-sach-bao-hanh" class="inline font-bold text-blue-500 hover:underline" target="_blank"> Xem chi tiết</a><p>Xem thông tin kích hoạt bảo hành các sản phẩm Apple <a class="inline font-bold text-blue-500 hover:underline" target="_blank" href="https://cellphones.com.vn/kich-hoat-bao-hanh-sam-pham-apple">Chi tiết tại đây</a></p></div></div></div><div class="swiper-slide h-auto!" style="height: calc(50% - 4px); width: 292px; margin-top: 8px; margin-right: 8px;"><div class="flex h-full flex-col gap-2.5 rounded-2xl bg-neutral-50 p-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><rect width="24" height="24" fill="url(#paint0_linear_12715_7378)" rx="4"></rect><path stroke="url(#paint1_linear_12715_7378)" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5.25 10.5h1.5m-1.5 3h1.5m3.75-8.25v1.5m3-1.5v1.5m5.25 3.75h-1.5m1.5 3h-1.5m-3.75 5.25v-1.5m-3 1.5v-1.5m-1.75 0h6.5a2 2 0 0 0 2-2v-6.5a2 2 0 0 0-2-2h-6.5a2 2 0 0 0-2 2v6.5a2 2 0 0 0 2 2m2-3h2.5a1 1 0 0 0 1-1v-2.5a1 1 0 0 0-1-1h-2.5a1 1 0 0 0-1 1v2.5a1 1 0 0 0 1 1"></path><defs><lineargradient id="paint0_linear_12715_7378" x1="13.462" x2="-37.95" y1="-49.875" y2="-8.237" gradientUnits="userSpaceOnUse"><stop stop-color="#ED8A95"></stop><stop offset="0.816" stop-color="#C40016"></stop></lineargradient><lineargradient id="paint1_linear_12715_7378" x1="12" x2="12" y1="5.25" y2="18.75" gradientUnits="userSpaceOnUse"><stop stop-color="#FFF5F0"></stop><stop offset="0.67" stop-color="#F4C8D0"></stop></lineargradient></defs></svg><div class="">Hộp, Sách hướng dẫn, Cây lấy sim, Cáp Lightning - Type C</div></div></div><div class="swiper-slide h-auto!" style="height: calc(50% - 4px); width: 292px; margin-top: 8px; margin-right: 8px;"><div class="flex h-full flex-col gap-2.5 rounded-2xl bg-neutral-50 p-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><rect width="24" height="24" fill="url(#paint0_linear_12744_40811)" rx="4"></rect><g clip-path="url(#clip0_12744_40811)"><path stroke="url(#paint1_linear_12744_40811)" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m16.5 17.25 1.194-1.194a3.615 3.615 0 0 0 0-5.112L14.25 7.5m-6 3h-.008M5.25 9v3.129c0 .398.158.78.44 1.06l4.282 4.283a1.81 1.81 0 0 0 2.556 0l2.694-2.694a1.81 1.81 0 0 0 0-2.556L10.94 7.94a1.5 1.5 0 0 0-1.061-.44H6.75A1.5 1.5 0 0 0 5.25 9"></path></g><defs><lineargradient id="paint0_linear_12744_40811" x1="13.462" x2="-37.95" y1="-49.875" y2="-8.237" gradientUnits="userSpaceOnUse"><stop stop-color="#ED8A95"></stop><stop offset="0.816" stop-color="#C40016"></stop></lineargradient><lineargradient id="paint1_linear_12744_40811" x1="12.001" x2="12.001" y1="7.5" y2="18.001" gradientUnits="userSpaceOnUse"><stop stop-color="#FFF5F0"></stop><stop offset="0.67" stop-color="#F4C8D0"></stop></lineargradient><clippath id="clip0_12744_40811"><path fill="#fff" d="M3 3h18v18H3z"></path></clippath></defs></svg><div>Giá sản phẩm <b>đã bao gồm thuế VAT</b>, có hỗ trợ <a href="https://cellphones.com.vn/vat-refund" target="_blank" class="font-bold text-blue-500 hover:underline">hoàn thuế VAT - Tax Refund</a> cho khách du lịch.</div></div></div></div><button title="Previous" class="swiper-button-prev shadow-bottom-400 absolute left-0 z-10 flex -translate-y-1/2 cursor-pointer items-center justify-center border-neutral-100 bg-white/80 p-0 transition-all duration-150 after:hidden hover:bg-white top-[calc(50%-16px)] h-6 w-6 rounded-full md:h-6 md:w-6 pl-1 hover:scale-125 shadow-md opacity-0 !cursor-default swiper-button-lock" disabled=""><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 512 512" class="mr-1 size-6 text-neutral-800 md:mr-1.5 md:size-7.5" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="48" d="M328 112 184 256l144 144"></path></svg></button><button title="Next" class="swiper-button-next shadow-bottom-400 absolute right-0 z-10 flex -translate-y-1/2 cursor-pointer items-center justify-center border-neutral-100 bg-white/80 p-0 transition-all duration-150 after:hidden hover:bg-white top-[calc(50%-16px)] h-6 w-6 rounded-full md:h-6 md:w-6 pr-1 hover:scale-125 shadow-md opacity-0 !cursor-default swiper-button-lock" disabled=""><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 512 512" class="ml-1 size-6 text-neutral-800 md:ml-1.5 md:size-7.5" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="48" d="m184 112 144 144-144 144"></path></svg></button><div class="swiper-pagination mx-auto mt-0! justify-center gap-1 empty:hidden flex swiper-pagination-clickable swiper-pagination-bullets swiper-pagination-horizontal swiper-pagination-lock"><div class="bg-neutral-300 only:hidden only:mt-0 mt-4 w-2 md:w-2.5 h-0.5 md:h-1 rounded-full transition-all duration-300 cursor-pointer !bg-primary-500 !w-4 md:!w-5"></div></div></div></div></div></div><div class="my-5 w-full empty:hidden"><section id="thong-so-ky-thuat"><div class="mb-4 flex items-center justify-between"><h2 class="text-md font-bold md:text-xl">Thông số kỹ thuật</h2><button data-slot="button" class="cpsui:flex cpsui:items-center cpsui:justify-center cpsui:gap-2x-small cpsui:cursor-pointer cpsui:disabled:cursor-not-allowed cpsui:border cpsui:border-[1px] cpsui:text-small cpsui:px-1x-small cpsui:py-2x-small cpsui:min-h-[24px] cpsui:rounded-full cpsui:border-pure-white cpsui:text-info-500 cpsui:bg-pure-white cpsui:hover:border-neutral-50 cpsui:hover:bg-neutral-50 cpsui:disabled:border-pure-white cpsui:disabled:text-black-300 cpsui:disabled:bg-pure-white font-medium">Xem tất cả <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 512 512" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="48" d="m184 112 144 144-144 144"></path></svg></button></div><table class="w-full border-separate border-spacing-0 overflow-hidden rounded-lg border border-neutral-200 md:rounded-2xl TechnicalInfo_technical-info__EUeVE"><tbody class="border-separate border-spacing-0"><tr class="w-full text-base last:border-0"><td class="w-35/100 border-r border-neutral-200 bg-neutral-50 px-4 py-2 text-neutral-800 md:w-3/10 border-b">Hệ điều hành khi ra mắt</td><td class="border-b border-neutral-200 px-4 py-2 border-b"><p class="">iOS 16</p></td></tr><tr class="w-full text-base last:border-0"><td class="w-35/100 border-r border-neutral-200 bg-neutral-50 px-4 py-2 text-neutral-800 md:w-3/10 border-b">Chipset</td><td class="border-b border-neutral-200 px-4 py-2 border-b"><p class="">Apple A15 Bionic 6 nhân</p></td></tr><tr class="w-full text-base last:border-0"><td class="w-35/100 border-r border-neutral-200 bg-neutral-50 px-4 py-2 text-neutral-800 md:w-3/10 border-b">Dung lượng RAM</td><td class="border-b border-neutral-200 px-4 py-2 border-b"><p class="">6 GB</p></td></tr><tr class="w-full text-base last:border-0"><td class="w-35/100 border-r border-neutral-200 bg-neutral-50 px-4 py-2 text-neutral-800 md:w-3/10 border-b">Bộ nhớ trong</td><td class="border-b border-neutral-200 px-4 py-2 border-b"><p class="">128 GB</p></td></tr><tr class="w-full text-base last:border-0"><td class="w-35/100 border-r border-neutral-200 bg-neutral-50 px-4 py-2 text-neutral-800 md:w-3/10 border-b">Loại CPU</td><td class="border-b border-neutral-200 px-4 py-2 border-b"><p class=""> 3.22 GHz</p></td></tr><tr class="w-full text-base last:border-0"><td class="w-35/100 border-r border-neutral-200 bg-neutral-50 px-4 py-2 text-neutral-800 md:w-3/10 border-b">GPU</td><td class="border-b border-neutral-200 px-4 py-2 border-b"><p class=""> Apple GPU 5 nhân</p></td></tr><tr class="w-full text-base last:border-0"><td class="w-35/100 border-r border-neutral-200 bg-neutral-50 px-4 py-2 text-neutral-800 md:w-3/10 border-b">Kích thước màn hình</td><td class="border-b border-neutral-200 px-4 py-2 border-b"><p class="">6.1 inches</p></td></tr><tr class="w-full text-base last:border-0"><td class="w-35/100 border-r border-neutral-200 bg-neutral-50 px-4 py-2 text-neutral-800 md:w-3/10 border-b">Công nghệ màn hình</td><td class="border-b border-neutral-200 px-4 py-2 border-b"><p class=""><a href="https://cellphones.com.vn/sforum/man-hinh-oled" target="_blank" rel="nofollow">OLED</a></p></td></tr><tr class="w-full text-base last:border-0"><td class="w-35/100 border-r border-neutral-200 bg-neutral-50 px-4 py-2 text-neutral-800 md:w-3/10 border-b">Độ phân giải màn hình</td><td class="border-b border-neutral-200 px-4 py-2 border-b"><p class="">2532 x 1170 pixels</p></td></tr><tr class="w-full text-base last:border-0"><td class="w-35/100 border-r border-neutral-200 bg-neutral-50 px-4 py-2 text-neutral-800 md:w-3/10 border-b">Tính năng màn hình</td><td class="border-b border-neutral-200 px-4 py-2 border-b"><p class="">Tần số quét 60Hz, 1200 nits, Kính cường lực Ceramic Shield,  Super Retina XDR</p></td></tr><tr class="w-full text-base last:border-0"><td class="w-35/100 border-r border-neutral-200 bg-neutral-50 px-4 py-2 text-neutral-800 md:w-3/10 border-b">Camera sau</td><td class="border-b border-neutral-200 px-4 py-2 border-b"><p class="">Camera góc rộng: 12MP, ƒ/1.5<br>Camera góc siêu rộng: 12MP, ƒ/2.4</p></td></tr><tr class="w-full text-base last:border-0"><td class="w-35/100 border-r border-neutral-200 bg-neutral-50 px-4 py-2 text-neutral-800 md:w-3/10 border-b">Camera trước</td><td class="border-b border-neutral-200 px-4 py-2 border-b"><p class="">12MP, ƒ/1.9 </p></td></tr><tr class="w-full text-base last:border-0"><td class="w-35/100 border-r border-neutral-200 bg-neutral-50 px-4 py-2 text-neutral-800 md:w-3/10 border-b">Pin</td><td class="border-b border-neutral-200 px-4 py-2 border-b"><p class="">3,279mAh</p></td></tr><tr class="w-full text-base last:border-0"><td class="w-35/100 border-r border-neutral-200 bg-neutral-50 px-4 py-2 text-neutral-800 md:w-3/10 border-b">Hỗ trợ mạng</td><td class="border-b border-neutral-200 px-4 py-2 border-b"><p class=""><a href="https://cellphones.com.vn/sforum/mang-5g-la-gi" target="_blank" rel="nofollow">5G</a></p></td></tr><tr class="w-full text-base last:border-0"><td class="w-35/100 border-r border-neutral-200 bg-neutral-50 px-4 py-2 text-neutral-800 md:w-3/10 border-b">Thẻ SIM</td><td class="border-b border-neutral-200 px-4 py-2 border-b"><p class="">2 SIM (nano‑SIM và eSIM)</p></td></tr><tr class="w-full text-base last:border-0"><td class="w-35/100 border-r border-neutral-200 bg-neutral-50 px-4 py-2 text-neutral-800 md:w-3/10 border-b">Công nghệ NFC</td><td class="border-b border-neutral-200 px-4 py-2 border-b"><p class="">Có</p></td></tr><tr class="w-full text-base last:border-0"><td class="w-35/100 border-r border-neutral-200 bg-neutral-50 px-4 py-2 text-neutral-800 md:w-3/10 border-b-0">Thời điểm ra mắt</td><td class="border-b border-neutral-200 px-4 py-2 border-b-0"><p class="">09/2022</p></td></tr></tbody></table></section></div><div class="my-5 w-full empty:hidden"></div><div class="mb-5 space-y-6 empty:hidden"><div><p class="text-md mb-2.5 font-bold sm:text-xl">Câu hỏi thường gặp</p><div class="space-y-2"><div class="cursor-pointer rounded-lg bg-gray-100 px-4 py-2 transition hover:bg-gray-300/50"><div class="flex w-full items-center justify-between rounded-lg py-2.5 text-left text-base font-semibold">Pin iPhone 14 có dung lượng bao nhiêu, dùng được trong bao lâu? Có hỗ trợ sạc nhanh không?<svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 512 512" class="size-4 transition-transform duration-300" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="48" d="m112 184 144 144 144-144"></path></svg></div><div class="overflow-hidden transition-all duration-300 ease-in-out opacity-0" style="max-height: 0px;"><div class="text-xs text-neutral-700"><div class="BlockFaqs_faqsAnswer__z8byi text-justify"><div>iPhone 14 có dung lượng 3.279 mAh với thời gian phát video tối đa 20 giờ, đồng thời tích hợp công suất sạc nhanh 20W trở lên hỗ trợ rút ngắn thời gian sạc pin xuống còn 1 tiếng rưỡi.</div></div></div></div></div><div class="cursor-pointer rounded-lg bg-gray-100 px-4 py-2 transition hover:bg-gray-300/50"><div class="flex w-full items-center justify-between rounded-lg py-2.5 text-left text-base font-semibold">iPhone 14 có mấy SIM? Bản eSim có dùng được ở Việt Nam?<svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 512 512" class="size-4 transition-transform duration-300" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="48" d="m112 184 144 144 144-144"></path></svg></div><div class="overflow-hidden transition-all duration-300 ease-in-out opacity-0" style="max-height: 0px;"><div class="text-xs text-neutral-700"><div class="BlockFaqs_faqsAnswer__z8byi text-justify"><div>iPhone 14 có 2 loại SIM cho người dùng lựa chọn bao gồm: SIM kép (1 SIM vật lý và 1 eSIM) và eSIM. Tuy nhiên, chỉ có mẫu máy iPhone 14 tại Mỹ sẽ bị loại bỏ khe cắm SIM vật lý và chỉ sử dụng eSIM. Do đó iPhone 14 chính hãng tại Việt Nam vẫn còn khay sim vật lý và hỗ trợ eSIM.</div></div></div></div></div><div class="cursor-pointer rounded-lg bg-gray-100 px-4 py-2 transition hover:bg-gray-300/50"><div class="flex w-full items-center justify-between rounded-lg py-2.5 text-left text-base font-semibold">Camera của iPhone 14 có cải tiến nổi bật nào so với iPhone 13?<svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 512 512" class="size-4 transition-transform duration-300" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="48" d="m112 184 144 144 144-144"></path></svg></div><div class="overflow-hidden transition-all duration-300 ease-in-out opacity-0" style="max-height: 0px;"><div class="text-xs text-neutral-700"><div class="BlockFaqs_faqsAnswer__z8byi text-justify"><div>Cả 2 model đều sở hữu 2 cảm biến 12MP, bao gồm 1 cảm biến góc rộng tiêu chuẩn và 1 cảm biến góc siêu rộng. Tuy nhiên, điểm nâng cấp tạo nên sự khác biệt ở camera của iPhone 14 là cảm biến camera chính có khẩu độ f/1.5 tăng khả năng chụp thiếu sáng thêm 49% so với iPhone 1, do đó đem lại khả năng chụp thiếu sáng tốt hơn. Ngoài ra, camera góc rộng cũng được tối ưu để phơi sáng nhanh và bắt nét hiệu quả hơn.</div></div></div></div></div><div class="cursor-pointer rounded-lg bg-gray-100 px-4 py-2 transition hover:bg-gray-300/50"><div class="flex w-full items-center justify-between rounded-lg py-2.5 text-left text-base font-semibold">iPhone 14 có mấy màu? Màu đặc trưng của iPhone 14 2023 là màu nào?<svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 512 512" class="size-4 transition-transform duration-300" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="48" d="m112 184 144 144 144-144"></path></svg></div><div class="overflow-hidden transition-all duration-300 ease-in-out opacity-0" style="max-height: 0px;"><div class="text-xs text-neutral-700"><div class="BlockFaqs_faqsAnswer__z8byi text-justify"><div>iPhone 14 bao gồm 5 màu sắc trẻ trung và năng động phù hợp với nhiều lứa tuổi và đối tượng, cụ thể là Blue (xanh), Purple (tím), Midnight (đen), Starlight (trắng), Product (đỏ). Trong đó, hai màu hoàn toàn mới so với iPhone 13 là màu xanh và tím.&nbsp;</div></div></div></div></div></div></div><a data-slot="button" class="cpsui:flex cpsui:items-center cpsui:justify-center cpsui:gap-2x-small cpsui:cursor-pointer cpsui:disabled:cursor-not-allowed cpsui:border cpsui:border-[1px] cpsui:text-base cpsui:px-medium cpsui:py-1x-small cpsui:min-h-[40px] cpsui:rounded-base cpsui:border-info-500 cpsui:text-info-500 cpsui:bg-pure-white cpsui:hover:bg-info-50 cpsui:disabled:border-black-300 cpsui:disabled:text-black-300 cpsui:disabled:bg-pure-white animate-fade-in mx-auto w-fit" href="https://cellphones.com.vn/so-sanh-iphone"><svg stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>So sánh các phiên bản iPhone</a></div></div><div class="flex-1 md:sticky md:max-w-[calc(50%-8px)] md:top-28"><div class="hidden empty:hidden md:block"><div class="grid overflow-hidden transition-all duration-300 ease-in-out grid-rows-[1fr] opacity-100 scale-100 md:mb-4"><div class="min-h-0"><div class="mb-2 hidden min-h-5 items-center gap-1 empty:hidden md:flex"></div><div class="relative z-10 w-full rounded-xl bg-linear-to-r from-blue-200 to-blue-300 p-px"><div class="w-full rounded-xl bg-white"><div class="flex flex-col rou